# ── Server Configuration ──────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database ──────────────────────────────────────────────────────────────────
# Default local postgres connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codity?schema=public"

# ── Security & Authentication ──────────────────────────────────────────────────
# Must be at least 32 characters in production
JWT_SECRET=super_secret_jwt_key_for_codity_development_only
JWT_REFRESH_SECRET=super_secret_refresh_key_for_codity_development_only

# ── CORS & CSRF ────────────────────────────────────────────────────────────────
# The URL where your frontend is hosted. Used to validate Origin/Referer headers.
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ── Worker Configuration ────────────────────────────────────────────────────────
# The base URL of the API for the worker to connect to
API_URL=http://localhost:3000/api/v1
# Max number of concurrent jobs this worker will process
CONCURRENCY=5
# Worker identifier
WORKER_NAME=local-worker-1

# IMPORTANT: You must generate a worker API key by running `npm run db:seed` in packages/api
# and copy the output here.
WORKER_API_KEY=replace_this_with_seed_output
