# Application Configuration
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/codity?schema=public"

# Security
JWT_SECRET="generate_a_secure_random_32_character_string_for_production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_SECRET="another_secure_random_string_here"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
